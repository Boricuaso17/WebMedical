@model WebMedical.Models.ViewModel.AppointmentDateAvailabilityRequest

@{
    ViewData["Title"] = "Appointment availability";
    var today = DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd");
    var days = new[]
    {
        new { Value = DayOfWeek.Monday, Label = "Monday" },
        new { Value = DayOfWeek.Tuesday, Label = "Tuesday" },
        new { Value = DayOfWeek.Wednesday, Label = "Wednesday" },
        new { Value = DayOfWeek.Thursday, Label = "Thursday" },
        new { Value = DayOfWeek.Friday, Label = "Friday" },
        new { Value = DayOfWeek.Saturday, Label = "Saturday" },
        new { Value = DayOfWeek.Sunday, Label = "Sunday" }
    };
}

<style>
    .availability-page {
        padding: 2rem;
    }

    .availability-layout {
        display: grid;
        grid-template-columns: minmax(20rem, 28rem) 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .availability-panel {
        background: #181818;
        color: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 12px 28px rgba(0, 0, 0, .25);
    }

    .availability-days {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .65rem;
    }

    .availability-day {
        min-height: 2.5rem;
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .5rem .65rem;
        border: 1px solid #3a3a3a;
        border-radius: 8px;
        background: #242424;
    }

    .availability-day input {
        width: 1rem;
        height: 1rem;
        padding: 0;
    }

    .availability-toolbar {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        align-items: end;
    }

    .availability-table-actions {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        align-items: end;
    }

    .availability-table-actions form {
        margin: 0;
    }

    .availability-page-size {
        width: 7rem;
    }

    .slot-select-cell {
        width: 3rem;
        text-align: center;
    }

    .slot-select-cell input {
        width: 1rem;
        height: 1rem;
        padding: 0;
    }

    .pagination-bar {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .pagination-actions {
        display: flex;
        gap: .5rem;
        align-items: center;
    }

    .pagination-actions button {
        min-width: 2.5rem;
        min-height: 2.5rem;
        border: 1px solid #222;
        border-radius: 8px;
        background: white;
    }

    .pagination-actions button:disabled {
        cursor: not-allowed;
        opacity: .45;
    }

    .pagination-page {
        min-width: 3rem;
        text-align: center;
        font-weight: 700;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 5rem;
        padding: .3rem .65rem;
        border-radius: 999px;
        font-size: .85rem;
        font-weight: 700;
    }

    .status-free {
        color: #166534;
        background: #dcfce7;
    }

    .status-booked {
        color: #842029;
        background: #f8d7da;
    }

    @@media (max-width: 1000px) {
        .availability-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<partial name="_Notification" />

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="availability-page">
    <div class="availability-layout">
        <section class="availability-panel">
            <h1>Create availability</h1>
            
            @* Create Availability Slots Form *@
            <form asp-action="Create" asp-controller="AppointmentDateAvailability" method="post" class="form-column">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-grid">
                    <div class="form-field">
                        <label asp-for="StartDate">Start date</label>
                        <input asp-for="StartDate" type="date" min="@today" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <div class="form-field">
                        <label asp-for="EndDate">End date</label>
                        <input asp-for="EndDate" type="date" min="@today" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-field">
                        <label asp-for="StartTime">Start time</label>
                        <input asp-for="StartTime" type="time" step="1800" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>

                    <div class="form-field">
                        <label asp-for="EndTime">End time</label>
                        <input asp-for="EndTime" type="time" step="1800" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-field">
                    <label>Days</label>
                    <div class="availability-days">
                        @foreach (var day in days)
                        {
                            <label class="availability-day">
                                <input type="checkbox"
                                       name="SelectedDays"
                                       value="@((int)day.Value)"
                                       checked="@Model.SelectedDays.Contains(day.Value)" />
                                <span>@day.Label</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btnAction"><i class="bi bi-calendar-plus"></i>&nbsp; Create slots</button>
                </div>
            </form>
        </section>

        @* Table of availabilities slots  *@
        <section>
            <div class="availability-toolbar">
                <div class="form-field">
                    <label for="startDate">Start date</label>
                    <input type="date" id="startDate" min="@today" />
                </div>
                <div class="form-field">
                    <label for="endDate">End date</label>
                    <input type="date" id="endDate" min="@today" />
                </div>
            </div>

            <div class="availability-table-actions">
                <div class="form-field">
                    <label for="pageSize">Rows</label>
                    <select id="pageSize" class="availability-page-size">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>

                <div class="form-actions">
                    <button type="button" id="toggleSelectMode" class="btnAction">
                        <i class="bi bi-check2-square"></i>&nbsp; Select slots
                    </button>

                    <form id="bulkDeleteForm" asp-action="DeleteSlots" asp-controller="AppointmentDateAvailability" method="post" data-delete-name="selected slots">
                        @Html.AntiForgeryToken()
                        <div id="bulkDeleteInputs"></div>
                        <button type="submit" id="bulkDeleteButton" class="btn btnDelete" disabled>
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </form>
                </div>
            </div>

            <div class="table-container">
                <table id="slotsTable" class="table table-striped table-hover">
                    <thead class="table-dark"></thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="pagination-bar">
                <span id="paginationSummary"></span>
                <div class="pagination-actions">
                    <button type="button" id="previousPage" aria-label="Previous page"><i class="bi bi-chevron-left"></i></button>
                    <span id="currentPageLabel" class="pagination-page"></span>
                    <button type="button" id="nextPage" aria-label="Next page"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let allSlots = [];
        let currentPage = 1;
        let pageSize = 10;
        let selectionMode = false;
        const selectedSlotIds = new Set();

        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function setInitialDateRange() {
            const today = new Date();
            const endDate = new Date();
            endDate.setDate(today.getDate() + 14);

            document.querySelector("#startDate").value = today.toISOString().slice(0, 10);
            document.querySelector("#endDate").value = endDate.toISOString().slice(0, 10);
        }

        function formatTime(time) {
            if (!time) {
                return "";
            }

            const [hour, minute] = time.split(":");
            const date = new Date();
            date.setHours(Number(hour), Number(minute), 0);

            return date.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
        }

        function getTotalPages() {
            return Math.max(1, Math.ceil(allSlots.length / pageSize));
        }

        function getCurrentPageSlots() {
            const start = (currentPage - 1) * pageSize;
            const end = start + pageSize;

            return allSlots.slice(start, end);
        }

        function syncBulkDeleteButton() {
            document.querySelector("#bulkDeleteButton").disabled = selectedSlotIds.size === 0;
        }

        function buildBulkDeleteInputs() {
            const container = document.querySelector("#bulkDeleteInputs");
            container.innerHTML = "";

            selectedSlotIds.forEach(function (id) {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "slotIds";
                input.value = id;
                container.appendChild(input);
            });
        }

        function renderPagination() {
            const totalPages = getTotalPages();
            const startRow = allSlots.length === 0 ? 0 : (currentPage - 1) * pageSize + 1;
            const endRow = Math.min(currentPage * pageSize, allSlots.length);

            document.querySelector("#paginationSummary").textContent = `Showing ${startRow}-${endRow} of ${allSlots.length}`;
            document.querySelector("#currentPageLabel").textContent = `${currentPage} / ${totalPages}`;
            document.querySelector("#previousPage").disabled = currentPage <= 1;
            document.querySelector("#nextPage").disabled = currentPage >= totalPages;
        }

        function renderTable() {
            const table = $("#slotsTable");
            const thead = table.find("thead");
            const tbody = table.find("tbody");
            const pageSlots = getCurrentPageSlots();

            thead.empty();
            tbody.empty();

            const headerRow = $("<tr>");

            if (selectionMode) {
                headerRow.append(`
                    <th class="slot-select-cell">
                        <input type="checkbox" id="selectPageSlots" aria-label="Select page slots" />
                    </th>
                `);
            }

            headerRow.append("<th>Date</th>");
            headerRow.append("<th>Time</th>");
            headerRow.append("<th>Status</th>");
            headerRow.append("<th>Actions</th>");
            thead.append(headerRow);

            pageSlots.forEach(function (slot) {
                const row = document.createElement("tr");
                const statusClass = slot.isBooked ? "status-booked" : "status-free";
                const statusText = slot.isBooked ? "Booked" : "Free";

                if (selectionMode) {
                    const selectTd = document.createElement("td");
                    selectTd.classList.add("slot-select-cell");

                    const checkbox = document.createElement("input");
                    checkbox.type = "checkbox";
                    checkbox.value = slot.id;
                    checkbox.disabled = slot.isBooked;
                    checkbox.checked = selectedSlotIds.has(slot.id);
                    checkbox.addEventListener("change", function () {
                        if (checkbox.checked) {
                            selectedSlotIds.add(slot.id);
                        } else {
                            selectedSlotIds.delete(slot.id);
                        }

                        syncBulkDeleteButton();
                    });

                    selectTd.appendChild(checkbox);
                    row.appendChild(selectTd);
                }

                row.insertAdjacentHTML("beforeend", `
                    <td>${slot.date}</td>
                    <td>${formatTime(slot.time)}</td>
                    <td><span class="status-pill ${statusClass}">${statusText}</span></td>
                `);

                const actionsTd = document.createElement("td");

                if (!slot.isBooked) {
                    const deleteForm = document.createElement("form");
                    deleteForm.method = "post";
                    deleteForm.action = `/AppointmentDateAvailability/DeleteSlot?id=${slot.id}`;
                    deleteForm.dataset.deleteName = `${slot.date} ${formatTime(slot.time)}`;

                    const tokenInput = document.createElement("input");
                    tokenInput.type = "hidden";
                    tokenInput.name = "__RequestVerificationToken";
                    tokenInput.value = getAntiForgeryToken();

                    const deleteBtn = document.createElement("button");
                    deleteBtn.type = "submit";
                    deleteBtn.classList.add("btn", "btnDelete");
                    deleteBtn.innerHTML = `<i class="fa-solid fa-trash-can"></i>`;

                    deleteForm.appendChild(tokenInput);
                    deleteForm.appendChild(deleteBtn);
                    actionsTd.appendChild(deleteForm);
                }

                row.appendChild(actionsTd);
                tbody.append(row);
            });

            const selectPageSlots = document.querySelector("#selectPageSlots");

            if (selectPageSlots) {
                const selectablePageSlots = pageSlots.filter(slot => !slot.isBooked);
                selectPageSlots.checked = selectablePageSlots.length > 0 &&
                    selectablePageSlots.every(slot => selectedSlotIds.has(slot.id));

                selectPageSlots.addEventListener("change", function () {
                    selectablePageSlots.forEach(function (slot) {
                        if (selectPageSlots.checked) {
                            selectedSlotIds.add(slot.id);
                        } else {
                            selectedSlotIds.delete(slot.id);
                        }
                    });

                    syncBulkDeleteButton();
                    renderTable();
                });
            }

            syncBulkDeleteButton();
            renderPagination();
        }

        async function updateTable() {
            const startDate = document.querySelector("#startDate").value;
            const endDate = document.querySelector("#endDate").value;

            if (!startDate || !endDate) {
                return;
            }

            const response = await fetch(`/AppointmentDateAvailability/GetSlotsByDateRange?startDate=${startDate}&endDate=${endDate}`);
            allSlots = await response.json();
            currentPage = 1;
            selectedSlotIds.clear();
            renderTable();
        }

        document.querySelector("#startDate").addEventListener("change", updateTable);
        document.querySelector("#endDate").addEventListener("change", updateTable);

        document.querySelector("#pageSize").addEventListener("change", function (event) {
            pageSize = Number(event.target.value);
            currentPage = 1;
            renderTable();
        });

        // Previous Page Btn
        document.querySelector("#previousPage").addEventListener("click", function () {
            if (currentPage > 1) {
                currentPage -= 1;
                renderTable();
            }
        });

        // Next Page Btn
        document.querySelector("#nextPage").addEventListener("click", function () {
            if (currentPage < getTotalPages()) {
                currentPage += 1;
                renderTable();
            }
        });

        document.querySelector("#toggleSelectMode").addEventListener("click", function () {
            selectionMode = !selectionMode;
            selectedSlotIds.clear();
            document.querySelector("#toggleSelectMode").innerHTML = selectionMode
                ? `<i class="bi bi-x-square"></i>&nbsp; Cancel selection`
                : `<i class="bi bi-check2-square"></i>&nbsp; Select slots`;
            renderTable();

            const individualBtnDelete = document.querySelectorAll(".table-container button.btnDelete");

            individualBtnDelete.forEach(btn => {
                btn.hidden = selectionMode;
                });
        });

        document.querySelector("#bulkDeleteForm").addEventListener("submit", function (event) {
            if (selectedSlotIds.size === 0) {
                event.preventDefault();
                return;
            }

            buildBulkDeleteInputs();
        });

        setInitialDateRange();
        updateTable();
    </script>
}
