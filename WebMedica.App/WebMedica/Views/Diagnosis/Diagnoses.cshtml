@model List<WebMedical.Models.Domain.Diagnosis>

<style>
        .addBtn {
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        background: black;
        color: white;
        height: 3rem;
        width: 11rem;
        border-radius: 10px;
        padding: 1rem;
    }

    .table-container {
        border-radius: 10px;
        overflow: hidden;
        margin-top: 5rem;
    }
</style>


<div class="container">

    <a asp-action="Add" asp-controller="Diagnosis" class="addBtn"><i class="fa-solid fa-plus"></i> &nbsp; Add Diagnosis</a>

    <div class="table-container">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <td>Name</td>
                    <td>Description</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var diagnosis in Model)
                {
                    <tr>
                        <td>@diagnosis.Name</td>
                        <td>@diagnosis.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>