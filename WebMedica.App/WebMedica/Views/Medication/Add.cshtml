@model WebMedical.Models.Domain.Medication

@{
    ViewData["Title"] = "Add";
}

<partial name="_Notification" />

<div class="form-page">
    <div class="form-modal">
        <h1>@ViewBag.Action</h1>
        <h4>Medication</h4>

        <form asp-action="@ViewBag.Action" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (ViewBag.Action == "Edit")
            {
                <input asp-for="Id" type="hidden" />
            }

            <div class="form-field">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btnAction"><i class="bi bi-plus-circle"></i> &nbsp; @ViewBag.Action</button>
                <a asp-action="Catalog" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
