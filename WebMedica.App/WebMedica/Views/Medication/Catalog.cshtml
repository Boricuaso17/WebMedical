@model List<WebMedical.Models.Domain.Medication>

<style>
    .addBtn {
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        background: black;
        color: white;
        height: 3rem;
        width: 11rem;
        border-radius: 10px;
        padding: 1rem;
    }

    .table-container {
        border-radius: 10px;
        overflow: hidden;
        margin-top: 5rem;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <h1>@TempData["SuccessMessage"]</h1>
}

<div class="container">
    
    <a class="addBtn" asp-action="Add" asp-controller="Medication"><i class="fa-solid fa-prescription-bottle-medical"></i> &nbsp; Add Medication</a>

    <div class="table-container">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <td>Nombre</td>
                    <td>Acciones</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var medication in Model)
                {
                    <tr>
                        <td>@medication.Name</td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">

                                <a asp-action="Edit" asp-route-id="@medication.Id" class="btn btn-primary"><i class="bi bi-pencil-square"></i> </a>

                                <form asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>