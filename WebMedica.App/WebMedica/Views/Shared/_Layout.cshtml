<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebMedical</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/img/Logo_NoBg.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebMedical.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/WebMedical.css" asp-append-version="true" />
</head>
<body>
    <header>
    </header>

    <div class="layout-wrapper">

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <partial name="_SidebarMenu" />
        }

        <div class="main-content">
            <main role="main">
                @RenderBody()
            </main>

            @* <footer class="border-top footer text-muted">
                <div class="container-fluid">
                    &copy; 2026 - WebMedical -
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer> *@
        </div>
    </div>
    <partial name="_DeleteConfirmation" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
