<style>

    /* SideBar ======================================================================================================================================================================================*/
    /* Sidebar */
    .sidebar-menu {
        width: 250px;
        min-height: 100vh;
        background: #171717;
        color: white;
        flex-shrink: 0;
        transition: width 0.3s ease;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        /* Sidebar colapsado */
        .sidebar-menu.collapsed {
            width: 70px;
        }

        /* Listas solo dentro del sidebar */
        .sidebar-menu ul {
            list-style: none;
            margin: 0;
            padding: 1rem 0;
        }

        .sidebar-menu img {
            height: 80px;
            margin: .8rem 0 0 .8rem;
        }

    /* Sidebar END ==========================================================================================================================================================================================*/
    .top {
    }

    .middle {
        flex: 1; 
    }

    .bottom {
        margin-top: auto;
    }

        .bottom ul {
            padding: 0;
            margin: 0;
        }

        .bottom li {
            color: white;
        }

        ul li{
        margin: 0;
        }

        ul li:hover{
            background: #444444;
        }

    li a {
        display: block;
        text-decoration: none;
        color: white;
        height: 100%;
        width: 100%;
        padding: 10px 20px;
    }

        /* Settings Menu =========================================================================================================================================================================================*/
    .settings-menu {
        position: absolute;
        left: 20px;
        bottom: 75px;
        width: 220px;
        background: #333;
        color: white;
        border-radius: 14px;
        padding: 10px;
        display: none;
        flex-direction: column;
        gap: 6px;
        box-shadow: 0 10px 25px rgba(0,0,0,.4);
        z-index: 1000;
    }

        .settings-menu.show {
            display: flex;
        }

        .settings-menu a,
        .settings-menu button {
            width: 100%;
            background: transparent;
            border: none;
            color: white;
            padding: 10px;
            text-align: left;
            border-radius: 8px;
            text-decoration: none;
            cursor: pointer;
        }

            .settings-menu a:hover,
            .settings-menu button:hover,
            #settingsBtn:hover {
                background: #444;
                border-radius: 0;
            }

        .settings-menu form {
            width: 100%;
            margin: 0;
            padding: 0;
        }

            .settings-menu form button {
                width: 100%;
            }

    .settings-btn {
        width: 100%;
        text-align: start;
        background: #171717;
        color: white;
        margin: 0;
        padding: 10px 20px;
        border: none;
        cursor: pointer;
    }
    /* Settings Menu END ======================================================================================================================================================================================*/
</style>

<div class="sidebar-menu">
    <div class="top">
        <a asp-action="Index" asp-controller="Home"><img src="/img/Logo&Txt_NoBg.png" /></a>
    </div>

    <div class="middle">
        <ul class="">
            <li >
                <a c asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i>&nbsp; Home</a>
            </li>
            <li >
                <a  asp-controller="User" asp-action="Add"><i class="bi bi-person-add"></i>&nbsp; Create User</a>
            </li>
            <li >
                <a  asp-controller="Appointment" asp-action="Index">Appointments</a>
            </li>
           <li c>
                <a  asp-controller="Medication" asp-action="Catalog">Medicine</a>
            </li>
        </ul>
    </div>
    
    <div class="bottom">

        <ul>
            <li ><i class="fa-solid fa-circle-user"></i> &nbsp; @User.Identity.Name </li>

            <li id="settingsBtn" > <i class="fa-solid fa-gear"></i> &nbsp; Settings </button> </li>
        </ul>

        @* Settings Menu *@
        <div id="settingsMenu" class="settings-menu">
            <a href="#"> <i class="fa-solid fa-user"></i> Profile </a> 
            <a href="#"> <i class="fa-solid fa-gear"></i> Settings </a>

            <form asp-action="Logout" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <button type="submit">
                    <i class="fa-solid fa-right-from-bracket"></i> 
                    Logout
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    const settingsBtn = document.getElementById("settingsBtn");
    const settingsMenu = document.getElementById("settingsMenu");

    settingsBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        settingsMenu.classList.toggle("show");
    });

    document.addEventListener("click", function () {
        settingsMenu.classList.remove("show");
    });

    settingsMenu.addEventListener("click", function (e) {
        e.stopPropagation();
    });
</script>