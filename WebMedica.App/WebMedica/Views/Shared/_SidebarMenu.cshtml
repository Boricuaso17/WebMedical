<style>

    /* SideBar ======================================================================================================================================================================================*/
    /* Sidebar */
    .sidebar-menu {
        width: 250px;
        min-height: 100vh;
        background: #171717;
        color: white;
        flex-shrink: 0;
        transition: width 0.3s ease, min-height 0.3s ease;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        /* Sidebar colapsado */
        .sidebar-menu.collapsed {
            width: 70px;
        }

        /* Listas solo dentro del sidebar */
        .sidebar-menu ul {
            list-style: none;
            margin: 0;
            padding: 1rem 0;
        }

        .sidebar-menu img {
            height: 72px;
            max-width: 100%;
        }

    /* Sidebar END ==========================================================================================================================================================================================*/
    .sidebar-menu .top {
        min-height: 6rem;
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .8rem .75rem .4rem;
    }

    .sidebar-logo-link {
        min-width: 0;
        flex: 1;
    }

    .sidebar-toggle {
        width: 2.75rem;
        height: 2.75rem;
        flex: 0 0 2.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #444;
        border-radius: 10px;
        background: #242424;
        color: white;
        cursor: pointer;
        transition: background-color .2s ease, border-color .2s ease;
    }

        .sidebar-toggle:hover,
        .sidebar-toggle:focus {
            background: #333;
            border-color: #666;
        }

    .sidebar-label {
        display: inline;
        white-space: nowrap;
    }

    .middle {
        flex: 1; 
    }

    .bottom {
        margin-top: auto;
    }

        .bottom ul {
            padding: 0;
            margin: 0;
        }

        .bottom li {
            color: white;
        }

        .sidebar-menu ul li{
        margin: 0;
        }

        .sidebar-menu ul li:hover{
            background: #444444;
        }

    .sidebar-menu li > a,
    .sidebar-menu li > span {
        display: flex;
        align-items: center;
        gap: .5rem;
        text-decoration: none;
        color: white;
        height: 100%;
        width: 100%;
        padding: 10px 20px;
    }

        /* Settings Menu =========================================================================================================================================================================================*/
    .settings-menu {
        position: absolute;
        left: 20px;
        bottom: 75px;
        width: 220px;
        background: #333;
        color: white;
        border-radius: 14px;
        padding: 10px;
        display: none;
        flex-direction: column;
        gap: 6px;
        box-shadow: 0 10px 25px rgba(0,0,0,.4);
        z-index: 1000;
    }

        .settings-menu.show {
            display: flex;
        }

        .settings-menu a,
        .settings-menu button {
            width: 100%;
            background: transparent;
            border: none;
            color: white;
            padding: 10px;
            text-align: left;
            border-radius: 8px;
            text-decoration: none;
            cursor: pointer;
        }

            .settings-menu a:hover,
            .settings-menu button:hover,
            #settingsBtn:hover {
                background: #444;
                border-radius: 0;
            }

        .settings-menu form {
            width: 100%;
            margin: 0;
            padding: 0;
        }

            .settings-menu form button {
                width: 100%;
            }

    .settings-btn {
        width: 100%;
        text-align: start;
        background: #171717;
        color: white;
        margin: 0;
        padding: 10px 20px;
        border: none;
        cursor: pointer;
    }

    .sidebar-menu.collapsed .top {
        justify-content: center;
        padding-left: .5rem;
        padding-right: .5rem;
    }

    .sidebar-menu.collapsed .sidebar-logo-link,
    .sidebar-menu.collapsed .sidebar-label {
        display: none;
    }

    .sidebar-menu.collapsed li > a,
    .sidebar-menu.collapsed li > span,
    .sidebar-menu.collapsed .settings-btn {
        justify-content: center;
        padding-left: .5rem;
        padding-right: .5rem;
    }

    .sidebar-menu.collapsed .settings-menu {
        left: 70px;
    }
    /* Settings Menu END ======================================================================================================================================================================================*/
</style>

<div class="sidebar-menu">
    <div class="top">
        <a class="sidebar-logo-link" asp-action="Index" asp-controller="Home"><img src="/img/Logo&Txt_NoBg.png" alt="WebMedical" /></a>

        <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Minimize menu" aria-expanded="true">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="middle">
        <ul class="">
            <li >
                <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house-chimney"></i><span class="sidebar-label">Home</span></a>
            </li>
            <li >
                <a asp-controller="UserAdmin" asp-action="Add"><i class="bi bi-person-add"></i><span class="sidebar-label">Create User</span></a>
            </li>
            <li >
                <a asp-controller="Appointment" asp-action="Index"><i class="bi bi-calendar2"></i><span class="sidebar-label">Appointments</span></a>
            </li>
            <li>
                <a asp-controller="AppointmentDateAvailability" asp-action="Index"><i class="bi bi-calendar-plus"></i><span class="sidebar-label">Availability</span></a>
            </li>
           <li>
                <a asp-controller="Medication" asp-action="Catalog"><i class="bi bi-capsule-pill"></i><span class="sidebar-label">Medicine</span></a>
            </li>
        </ul>
    </div>
    
    <div class="bottom">

        <ul>
            <li><span><i class="fa-solid fa-circle-user"></i><span class="sidebar-label">@User.Identity.Name</span></span></li>

            <li id="settingsBtn"><span><i class="fa-solid fa-gear"></i><span class="sidebar-label">Settings</span></span></li>
        </ul>



        @* Settings Menu =======================================================*@
        <div id="settingsMenu" class="settings-menu">
            <a href="#"> <i class="bi bi-shield-lock"></i> &nbsp; Change password </a>
            <a href="#"> <i class="fa-regular fa-envelope"></i> &nbsp; Change Email </a>

            <form asp-action="Logout" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <button type="submit">
                    <i class="fa-solid fa-right-from-bracket"></i> 
                    Logout
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    const settingsBtn = document.getElementById("settingsBtn");
    const settingsMenu = document.getElementById("settingsMenu");
    const sidebarMenu = document.querySelector(".sidebar-menu");
    const sidebarToggle = document.getElementById("sidebarToggle");
    const mobileSidebarQuery = window.matchMedia("(max-width: 900px)");

    function syncSidebarToggleState() {
        const isMobile = mobileSidebarQuery.matches;
        const isExpanded = isMobile
            ? sidebarMenu.classList.contains("mobile-open")
            : !sidebarMenu.classList.contains("collapsed");

        sidebarToggle.setAttribute("aria-expanded", isExpanded.toString());
        sidebarToggle.setAttribute("aria-label", isMobile
            ? (isExpanded ? "Close menu" : "Open menu")
            : (isExpanded ? "Minimize menu" : "Expand menu"));
    }

    function normalizeSidebarMode() {
        if (mobileSidebarQuery.matches) {
            sidebarMenu.classList.remove("collapsed");
            sidebarMenu.classList.remove("mobile-open");
        } else {
            sidebarMenu.classList.remove("mobile-open");
        }

        settingsMenu.classList.remove("show");
        syncSidebarToggleState();
    }

    sidebarToggle.addEventListener("click", function (e) {
        e.stopPropagation();

        if (mobileSidebarQuery.matches) {
            sidebarMenu.classList.toggle("mobile-open");
        } else {
            sidebarMenu.classList.toggle("collapsed");
        }

        settingsMenu.classList.remove("show");
        syncSidebarToggleState();
    });

    settingsBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        settingsMenu.classList.toggle("show");
    });

    document.addEventListener("click", function () {
        settingsMenu.classList.remove("show");
    });

    settingsMenu.addEventListener("click", function (e) {
        e.stopPropagation();
    });

    mobileSidebarQuery.addEventListener("change", normalizeSidebarMode);
    normalizeSidebarMode();
</script>
