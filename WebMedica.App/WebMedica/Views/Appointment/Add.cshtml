@model WebMedical.Models.ViewModel.AddAppointmentRequest

<div class="form-page">
    <div class="form-modal">
        <h1>@ViewBag.Action</h1>
        <h4>Appointment</h4>
        <h5>@Model.UserLoginId</h5>

        <form method="post" asp-action="@ViewBag.Action" asp-controller="Appointment">

            <input asp-for="@Model.Id" type="hidden" />
            <input asp-for="@Model.UserLoginId"   type="hidden" />

            <div class="form-field">
                <label asp-for="Date"></label>
                <input asp-for="Date" type="date" />
            </div>

            <div class="form-field">
                <label asp-for="Time"></label>
                <input asp-for="Time" type="time" step="1800" />
            </div>

            <div class="form-field">
                <label asp-for="Reason"></label>
                <input asp-for="Reason" type="text" />
            </div>

            <div class="form-field">
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes"></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btnAction"><i class="bi bi-plus-circle"></i> &nbsp; @ViewBag.Action</button>
            </div>
        </form>
    </div>
</div>
