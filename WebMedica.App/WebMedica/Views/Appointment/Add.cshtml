@model WebMedical.Models.Domain.Appointment

<div class="container">
    <div>
        <form method="post" asp-action="Add" asp-controller="Appointment">
            <input asp-for="Id" value="@Model.Id" hidden />
            <input asp-for="Date" type="date" />
            <input asp-for="Reason" type="text" />
            <textarea asp-for="Notes"></textarea>

            <button type="submit" class="" >@ViewBag.Action</button>
        </form>
    </div>
</div>