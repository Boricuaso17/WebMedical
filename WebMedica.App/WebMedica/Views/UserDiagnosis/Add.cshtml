@model WebMedical.Models.ViewModel.AddUserDiagnosisRequest

<div class="form-page">
    <div class="form-modal">
        <h1>@ViewBag.Action</h1>
        <h4>User Diagnosis</h4>

        <form asp-action="@ViewBag.Action" asp-controller="UserDiagnosis" method="post">
            <input asp-for="UserId" type="hidden" />

            <div class="form-field">
                <label asp-for="Notes"></label>
                <input asp-for="Notes" type="text" />
            </div>

            <div class="form-field">
                <label asp-for="Status"></label>
                <input asp-for="Status" type="text" />
            </div>

            <div class="form-field">
                <label asp-for="DiagnosisId">Diagnosis</label>
                <select asp-for="DiagnosisId" asp-items="@Model.DiagnosisList">
                    <option value="">Select Diagnosis</option>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-circle"></i> &nbsp; @ViewBag.Action</button>
            </div>
        </form>
    </div>
</div>
