@model WebMedical.Models.ViewModel.AddUserDiagnosisRequest




<div>
    <form asp-action="@ViewBag.Action" asp-controller="UserDiagnosis" method="post">
        <input asp-for="UserId" type="hidden" />

        <input asp-for="Notes" type="text" />
        <input asp-for="Status" type="text" />
        <select asp-for="DiagnosisId" asp-items="@Model.DiagnosisList">
            <option value=""> Select Diagnosis </option>
        </select>

        <button type="submit">@ViewBag.Action</button>
    </form>
</div>