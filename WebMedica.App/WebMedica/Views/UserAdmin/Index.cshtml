@model WebMedical.Models.ViewModel.AddUserRequest


<style>
    .navbarRecord {
        background: #1e1e1e;
        width: 100%;
        height: 8rem;
    }

    .cardContainer {
        background: #24292e;
        width: 100%;
        height: 35rem;
        border-radius: 40px;
        padding: 1.5rem;
        color: white;
        margin-top: 2rem;
        display: grid;
        grid-template-columns: 250px 1fr;
        gap: 25px;
        margin-top: 2rem;
    }

    .sidebarCol {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

        .sidebar a {
            padding: 10px;
            border-radius: 10px;
            background: #1e1e1e;
            text-decoration: none;
            color: white;
            transition: 0.3s;
        }

            .sidebar a:hover {
                background: #2d333b;
                padding: 15px;
                transition: 0.3s;
            }

    .content {
        background: #1e1e1e;
        border-radius: 20px;
        padding: 20px;
    }

        .content label {
            font-weight: 700;
        }

        .content p {
            margin-bottom: .5rem;
        }

</style>
<div class="container">
    <div class="cardContainer">
        <div class="sidebarCol">
            <div>
                <h4>Record</h4>
            </div>

            <div class="sidebar">
                <a asp-action="Add" asp-controller="Appointment" asp-route-id="@Model.Id"><i class="fa-regular fa-calendar-days"></i> &nbsp; Appointments</a>
                <a asp-action="Index" asp-controller="UserDiagnosis" asp-route-userId="@Model.Id"><i class="fa-solid fa-stethoscope"></i> &nbsp; Diagnostics</a>
                <a asp-action="Record" asp-controller="Prescription" asp-route-patientId="@Model.Id"><i class="fa-solid fa-file-prescription"></i> &nbsp; Prescriptions</a>
            </div>
        </div>

        <div class="content">
            <h5>Información del usuario</h5>
            <label class="title">Nombre:</label>
            <p>@Model.FullName</p>

            <label>Seguro Social:</label>
            <p> @Model.SocialSecurityNumber</p>

            <label>Teléfono:</label>
            <p> @Model.Phone</p>

            <label>Direccion Fisical</label>
            <p>@Model.FisicalAddress <br /> @Model.FisicalAddressLine2</p>
            

            <label>Direccion Fisical</label>
            <p>@Model.PostalAddress <br /> @Model.PostalAddressLine2</p>

            <hr />

            <label>Usuario</label>
            <p>@Model.Username</p>

            <label>Email</label>
            <p>@Model.Email</p>

        </div>

    </div>
</div>
