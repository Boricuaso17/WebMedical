@model WebMedical.Models.ViewModel.ChangePasswordRequest

<div class="form-page">
    <div class="form-modal">
        <h1>Change Password</h1>

        <form asp-action="ChangePassword" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-field">
                <label asp-for="CurrentPassword"></label>
                <input type="password" asp-for="CurrentPassword" />
            </div>

            <div class="form-field">
                <label asp-for="NewPassword"></label>
                <input type="password" asp-for="NewPassword" />
            </div>

            <div class="form-field">
                <label asp-for="ConfirmPassword"></label>
                <input type="password" asp-for="ConfirmPassword" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btnAction">Update Password</button>
            </div>
        </form>
    </div>
</div>
