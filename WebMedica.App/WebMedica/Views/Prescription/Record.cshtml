@model List<WebMedical.Models.Domain.Prescription>

@{
    ViewData["Title"] = "Prescriptions";
}

<style>
    .addBtn {
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        background: black;
        color: white;
        height: 3rem;
        width: 12rem;
        border-radius: 10px;
        padding: 1rem;
    }

    .table-container {
        border-radius: 10px;
        overflow: hidden;
        margin-top: 2rem;
    }
</style>

<partial name="_Notification" />

<div class="container">
    <a class="addBtn" asp-action="Add" asp-controller="Prescription" asp-route-patientId="@ViewBag.PatientId">
        <i class="fa-solid fa-file-prescription"></i> &nbsp; Add Prescription
    </a>

    <div class="table-container">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <td>Date</td>
                    <td>Appointment</td>
                    <td>Diagnosis</td>
                    <td>Notes</td>
                    <td>Actions</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var prescription in Model)
                {
                    <tr>
                        <td>@prescription.Date</td>
                        <td>@prescription.Appointment?.Reason</td>
                        <td>@prescription.Diagnosis?.Name</td>
                        <td>@prescription.Notes</td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@prescription.Id" class="btn btnEdit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@prescription.Id" />
                                    <button type="submit" class="btn btnDelete">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
