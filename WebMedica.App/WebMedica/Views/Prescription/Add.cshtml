@model WebMedical.Models.ViewModel.AddPrescriptionRequest

@{
    ViewData["Title"] = ViewBag.Action;
}

<div class="form-page">
    <div class="form-modal">
        <h1>@ViewBag.Action</h1>
        <h4>Prescription</h4>

        <form asp-action="@ViewBag.Action" asp-controller="Prescription" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (ViewBag.Action == "Edit")
            {
                <input asp-for="Id" type="hidden" />
            }

            <input asp-for="PatientId" type="hidden" />
            <input asp-for="PrescribedById" type="hidden" />

            <div class="form-field">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" type="date" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="AppointmentId" class="control-label">Appointment</label>
                <select asp-for="AppointmentId" asp-items="@Model.AppointmentList">
                    <option value="">Select Appointment</option>
                </select>
                <span asp-validation-for="AppointmentId" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="DiagnosisId" class="control-label">Diagnosis</label>
                <select asp-for="DiagnosisId" asp-items="@Model.DiagnosisList">
                    <option value="">Select Diagnosis</option>
                </select>
                <span asp-validation-for="DiagnosisId" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@ViewBag.Action</button>
                <a asp-action="Record" asp-route-patientId="@Model.PatientId" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
