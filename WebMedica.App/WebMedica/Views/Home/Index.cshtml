@model WebMedical.Models.ViewModel.AddUserRequest

@{
    ViewData["Title"] = "Home Page";
}

<style>
    .containerHome{
        display: flex;
        justify-content: center;
    }

    .UserSearchContainer {
        display: flex;
        align-items: center;
        width: min(94%, 78rem);
        min-height: 28rem;
        background: #181818;
        margin-top: 5rem;
        color: white;
        padding: 3rem;
        border-radius: 8px;
        box-shadow: 0 12px 28px rgba(0,0,0,0.35);
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        width: 100%;
    }

    .search-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

    .inputContainer {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1rem;
    }
    
    label{
        margin-top: 0;
    }

    input {
        width: 100%;
        height: 3rem;
        padding: .75rem 1rem;
    }

    button {
        width: 10rem;
    }

</style>

<partial name="_Notification" />

<div class="text-center">
    <h1 class="display-4">Welcome to Web Medical App</h1>
</div>

<div class="containerHome">
    <div class="UserSearchContainer">
        <div class="inputContainer">

            <form method="get" asp-action="SearchUser" asp-controller="Home">
                <div class="search-grid">
                    <div class="form-field">
                        <label asp-for="Name">Nombre</label>
                        <input asp-for="Name" type="text" />
                    </div>

                    <div class="form-field">
                        <label asp-for="MiddleName">Segundo nombre</label>
                        <input asp-for="MiddleName" type="text" />
                    </div>

                    <div class="form-field">
                        <label asp-for="LastName">Apellido paterno</label>
                        <input asp-for="LastName" type="text" />
                    </div>

                    <div class="form-field">
                        <label asp-for="LastName2">Apellido materno</label>
                        <input asp-for="LastName2" type="text" />
                    </div>

                    <div class="form-field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" />
                    </div>

                    <div class="form-field">
                        <label asp-for="SocialSecurityNumber">Seguro Social</label>
                        <input asp-for="SocialSecurityNumber" type="text" />
                    </div>

                    <div class="form-field">
                        <label asp-for="Phone">Telefono</label>
                        <input asp-for="Phone" type="text" />
                    </div>
                </div>

                <button class="btnAction" type="submit"><i class="bi bi-search"></i> &nbsp; Search</button>
            </form>
        </div>
    </div>
</div>

