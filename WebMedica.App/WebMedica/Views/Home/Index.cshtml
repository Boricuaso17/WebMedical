@model WebMedical.Models.Domain.UserProfile
@{
    ViewData["Title"] = "Home Page";
}

<style>
    .containerHome{
        display: flex;
        justify-content: center;
    }

    .UserSearchContainer {
        display: flex;
        align-items: center;
        width: 80%;
        height: 30rem;
        background: #181818;
        margin-top: 5rem;
        color: white;
        padding: 3rem;
        border-radius: 8px;
        box-shadow: 0 12px 28px rgba(0,0,0,0.35);
    }

    form {
        display: flex;
        flex-direction: column;
        gap: .5rem;
        width: 100%;
    }

    .inputContainer {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    
    label{
        margin-top: 0;
    }

    input {
        width: 100%;
    }

    button {
        width: 7rem;
    }

</style>

<partial name="_Notification" />

<div class="text-center">
    <h1 class="display-4">Welcome to Web Medical App</h1>
</div>

<div class="containerHome">
    <div class="UserSearchContainer">
        <div class="inputContainer">

            <div>
                <form method="get" asp-action="SearchUser" asp-controller="Home">
                    <label asp-for="Name">Nombre</label>
                    <input type="text" asp-for="Name" />
                    <button class="btnAction" type="submit"><i class="bi bi-search"></i> &nbsp; Search</button>
                </form>
            </div>
            <div>
                <form method="post" asp-action="SearchUserBySSN" asp-controller="Home">
                    <label asp-for="SocialSecurityNumber">Social Security Number</label>
                    <input type="text" asp-for="SocialSecurityNumber" />
                    <button class="btnAction" type="submit"><i class="bi bi-search"></i> &nbsp; Search</button>
                </form>
            </div>
        </div>
    </div>
</div>
