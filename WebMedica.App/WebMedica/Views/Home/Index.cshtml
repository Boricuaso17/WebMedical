@model WebMedical.Models.User
@{
    ViewData["Title"] = "Home Page";
}

<style>
    .userSearchContainer {
        width: 100%;
        height: 30rem;
        background: #2e2e2e;
        margin-top: 5rem;
        color: white;
        padding: 3rem;
        border-radius: 20px;
    }

    .inputContainer {
        width:100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
</style>

<div class="text-center">
    <h1 class="display-4">Welcome to Web Medical App</h1>
</div>

<div class="userSearchContainer">
    <div class="inputContainer">

        <label for="name">Nombre</label>
        <div>
            <form method="post" asp-action="Index" asp-controller="Patient">
            <input type="text" id="name" asp-for="Name"/>
                <button type="submit">Search</button>
            </form>
        </div>
        
        <label for="name">Social Security Number</label>
        <div>
            <form method="post" asp-action="Index" asp-controller="Patient">
            <input type="text" id="SSN" asp-for="SocialSecurityNumberID"/>
            <button type="submit">Search</button>
            </form>
        </div>
    </div>
</div>