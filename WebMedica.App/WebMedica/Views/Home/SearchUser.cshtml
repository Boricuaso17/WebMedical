
@model List<WebMedical.Models.ViewModel.AddUserRequest>


<style>
    .cardContainer {
        display: flex;
        flex-direction: column;
        background: #181818;
        justify-content: space-between;
        align-items: center;
        height: 15rem;
        width: 20rem;
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 5px 5px 4px rgba(0, 0, 0, 0.25);
        color: white;
    }

    .btnAction {
        background: #737373;
        width: 100%;
        border: none;
        padding: 0 1rem;
        text-decoration: none;
        color: white;
    }

    .cardContainer a:hover {
            background: #818181;
            transition: background-color 0.3s;
    }

    .btnEdit {
        background: yellow;
    }

    .btnDelete {
        background: red;
    }

</style>

<div class="container">

    <h3 class="m-3">Usuario</h3>

    <div class="d-flex flex-wrap gap-3 justify-content-start">
        @foreach (var user in Model)
        {
            <div class="cardContainer">
                <h5>@user.FullName</h5>

                <a class="btnAction" asp-action="Index" asp-controller="UserAdmin" asp-route-guid="@user.Guid"><i class="fa-solid fa-clipboard-list"></i> &nbsp; Record</a>
            </div>
        }
    </div>
</div>

