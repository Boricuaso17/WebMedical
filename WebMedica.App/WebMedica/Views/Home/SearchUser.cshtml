
@model List<WebMedical.Models.ViewModel.AddUserRequest>


<style>
    .cardContainer {
        display: flex;
        flex-direction: column;
        background: #181818;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 5px 5px 4px rgba(0, 0, 0, 0.25);
        color: white;
    }
    .cardContainer p {
        margin: 0;
        font-size: 12pt;
    }

    .cardContainer :first-child{
        align-self:center;
        font-size: 16pt;
        font-weight: 700;
    }

    .cardContainer :last-child{

    }

    .results-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .btnAction {
        width: 100%;
    }

    hr{
        color: white;
        height: 2px;
        width: 90%;
        align-self:center;
    }

    @@media (max-width: 992px) {
        .results-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {
        .results-grid {
            grid-template-columns: 1fr;
        }

        .cardContainer {
            min-height: 0;
            gap: 1rem;
            margin-top: 1rem;
            border-radius: 8px;
            padding: 1rem;
        }
    }

</style>

<div class="container">

    <h3 class="m-3">Usuario</h3>

    <div class="results-grid">
        @foreach (var user in Model)
        {
            <div class="cardContainer">
                <p >@user.FullName</p>
                <hr />
                <p>@(user.UserLogin?.Email ?? "No email encontrado")</p>
                <p>@user.Phone</p>
                <p>@user.DateOfBirth</p>

                <a class="btnAction" asp-action="Index" asp-controller="UserAdmin" asp-route-guid="@user.Guid"><i class="fa-solid fa-clipboard-list"></i> &nbsp; Record</a>
            </div>
        }
    </div>
</div>

