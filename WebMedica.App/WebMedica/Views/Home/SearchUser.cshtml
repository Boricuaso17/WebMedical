
@model List<WebMedical.Models.ViewModel.AddUserRequest>


<style>
    .cardContainer {
        display: flex;
        flex-direction: column;
        background: #181818;
        justify-content: space-between;
        align-items: center;
        height: 15rem;
        width: 100%;
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 5px 5px 4px rgba(0, 0, 0, 0.25);
        color: white;
    }

    .results-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .btnAction {
        width: 100%;
    }

    @@media (max-width: 992px) {
        .results-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 640px) {
        .results-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container">

    <h3 class="m-3">Usuario</h3>

    <div class="results-grid">
        @foreach (var user in Model)
        {
            <div class="cardContainer">
                <p>@user.FullName</p>
                <p>@(user.UserLogin?.Email ?? "No email encontrado")</p>
                <p>@user.Phone</p>
                <p>@user.DateOfBirth</p>

                <a class="btnAction" asp-action="Index" asp-controller="UserAdmin" asp-route-guid="@user.Guid"><i class="fa-solid fa-clipboard-list"></i> &nbsp; Record</a>
            </div>
        }
    </div>
</div>

